{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "typelink",
  "version": "1.0.1",
  "identifier": "com.typelink.app",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TypeLink",
        "width": 340,
        "height": 420,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
